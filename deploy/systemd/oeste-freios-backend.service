## Copiar para /etc/systemd/system/oeste-freios-backend.service
## Depois: systemctl daemon-reload && systemctl enable --now oeste-freios-backend

[Unit]
Description=Oeste Freios - backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=oestefreios
Group=oestefreios
WorkingDirectory=/opt/oeste-freios/backend
EnvironmentFile=/opt/oeste-freios/backend/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Escrita restrita aos uploads e aos boletos privados.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/oeste-freios/backend/uploads /opt/oeste-freios/backend/storage/cobrancas
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Sem MemoryDenyWriteExecute: o JIT do V8 precisa de memória gravável+executável.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oeste-freios-backend

[Install]
WantedBy=multi-user.target
