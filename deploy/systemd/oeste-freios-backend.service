## Copiar para /etc/systemd/system/oeste-freios-backend.service
## Depois: systemctl daemon-reload && systemctl enable --now oeste-freios-backend
## Layout de releases (deploy atômico): roda de /opt/oeste-freios-app/current. Ainda no layout antigo?
## Rode deploy/migrar-para-releases.sh antes de trocar esta unit (ver DEPLOY.md "Deploy atômico").

[Unit]
Description=Oeste Freios - backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=oestefreios
Group=oestefreios
WorkingDirectory=/opt/oeste-freios-app/current/backend
EnvironmentFile=/opt/oeste-freios-app/shared/.env
ExecStart=/usr/bin/node dist/server.js
# always: reinicia até se o processo sair "limpo" por engano — API fora do ar nunca é o estado desejado.
Restart=always
RestartSec=3

# Escrita restrita aos uploads e aos boletos privados.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/oeste-freios-app/shared/uploads /opt/oeste-freios-app/shared/storage/cobrancas
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Sem MemoryDenyWriteExecute: o JIT do V8 precisa de memória gravável+executável.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oeste-freios-backend

[Install]
WantedBy=multi-user.target
