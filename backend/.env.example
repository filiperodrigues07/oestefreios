# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebird / CHERP
# CHERP_MODE=mock (padrão): repositórios em memória, sem depender do Firebird.
# CHERP_MODE=firebird: usa os repositórios reais em src/repositories/firebird/ —
# só funciona depois de preencher as queries (ver database/queries/CONTRATO.md)
# e apontar as credenciais abaixo para uma instância real do CHERP.
CHERP_MODE=mock
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\caminho\para\CHERP.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey

# Banco próprio da aplicação (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oeste_freios

# Autenticação
JWT_SECRET=troque-este-valor-em-producao-min-32-caracteres
JWT_REFRESH_SECRET=troque-este-outro-valor-em-producao-min-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed de desenvolvimento (nunca usar em produção)
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=Admin@123456
