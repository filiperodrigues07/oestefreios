# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebird / CHERP
# CHERP_MODE=mock (padrão): repositórios em memória, sem depender do Firebird.
# CHERP_MODE=firebird: usa os repositórios reais em src/repositories/firebird/,
# com SQL já escrito para o schema Questor (ver README "CHERP real (Fase 5)" e
# database/queries/CONTRATO.md) — aponte as credenciais abaixo pra instância real.
CHERP_MODE=mock
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\caminho\para\CHERP.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey
# CHAVE do usuário (tabela USUARIOS do CHERP) registrado como responsável por toda
# OS aberta/fechada através do app — ver README "OS no CHERP real (Fase 5+)".
FIREBIRD_OS_USUARIO_CHAVE=2

# Banco próprio da aplicação (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oeste_freios

# Autenticação
JWT_SECRET=troque-este-valor-em-producao-min-32-caracteres
JWT_REFRESH_SECRET=troque-este-outro-valor-em-producao-min-32-caracteres
SETTINGS_ENCRYPTION_KEY=chave-exclusiva-para-criptografar-configuracoes-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed de desenvolvimento (nunca usar em produção)
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=Admin@123456

# Consulta automática de veículos (somente backend)
DADOS_API_TOKEN=
DADOS_API_BASE_URL=https://api.dadosapi.com
VEHICLE_LOOKUP_MONTHLY_LIMIT=50
VEHICLE_LOOKUP_CACHE_TTL_DAYS=30

# Licença simultânea (usuários diferentes online ao mesmo tempo; 0 = sem limite)
LICENSE_MAX_SESSIONS=5
LICENSE_IDLE_MINUTES=15
SINGLE_SESSION_PER_USER=true
