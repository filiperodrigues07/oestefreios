# Template de produção — copiar para /opt/oeste-freios/backend/.env na VPS e preencher.
# NUNCA commitar o .env real (o .gitignore já bloqueia .env e .env.*, exceto os .example).
# chmod 600 no arquivo final: só o usuário `oestefreios` deve conseguir ler.

# Servidor
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://app.mecanicaoestefreios.com.br

# Firebird / CHERP — servidor de produção do cliente, já na nuvem (não precisa de VPN).
CHERP_MODE=firebird
FIREBIRD_HOST=
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=
FIREBIRD_USER=
FIREBIRD_PASSWORD=
# CHAVE (tabela USUARIOS do CHERP) do usuário responsável por toda OS aberta/fechada pelo app.
FIREBIRD_OS_USUARIO_CHAVE=

# Banco próprio da aplicação (Postgres local na VPS)
DATABASE_URL=postgresql://oeste_freios:TROQUE_ESSA_SENHA@localhost:5432/oeste_freios

# Autenticação — gerar cada um com: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
SETTINGS_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Usado só na primeira execução de `npm run db:seed` pra criar o admin real do sistema.
# Depois de logar a 1ª vez, troque a senha pela tela do app e pode deixar essas duas linhas
# como estão (rodar o seed de novo só reafirma esse e-mail/senha — não é acionado sozinho).
DEV_ADMIN_EMAIL=admin@mecanicaoestefreios.com.br
DEV_ADMIN_PASSWORD=TROQUE_ESSA_SENHA_ANTES_DE_RODAR_O_SEED

# Consulta automática de veículos (opcional — pode deixar em branco e configurar depois
# pela tela Configurações > Integrações, que grava criptografado no banco)
DADOS_API_TOKEN=
DADOS_API_BASE_URL=https://api.dadosapi.com
VEHICLE_LOOKUP_MONTHLY_LIMIT=50
VEHICLE_LOOKUP_CACHE_TTL_DAYS=30
